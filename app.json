{
  "expo": {
    "name": "Mi Caja Fuerte",
    "slug": "movi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4D3E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para proteger tus fotos, videos y documentos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B4D3E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para proteger tus archivos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita ver tus fotos y videos para guardarlos de forma segura."
        }
      ],
      "expo-document-picker",
      "expo-sharing"
    ]
  }
}